{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:interface:abs_iface_source_admit:1.0.0",
  "title": "safe source admission and reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_id",
    "request_id",
    "scope_id",
    "actor_id",
    "authority_ref",
    "candidate_hash",
    "payload",
    "result_state",
    "evidence_ids",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "interface_id": {
      "const": "ABS.IFACE.SOURCE.ADMIT"
    },
    "request_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "actor_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "authority_ref": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    },
    "result_state": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "INCONCLUSIVE",
        "STALE"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
