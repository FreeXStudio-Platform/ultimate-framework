{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:work-packet:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_packet_id",
    "objective",
    "parent_goal",
    "scope_ids",
    "inputs",
    "outputs",
    "requirements",
    "permissions",
    "capabilities_required",
    "dependencies",
    "rollback",
    "acceptance_criteria",
    "checks",
    "evidence_expected",
    "owner_role",
    "independent_verifier_role",
    "status",
    "exact_next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "work_packet_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "parent_goal": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "scope_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "external",
        "destructive"
      ],
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "destructive": {
          "type": "boolean"
        }
      }
    },
    "capabilities_required": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      }
    },
    "owner_role": {
      "type": "string",
      "minLength": 1
    },
    "independent_verifier_role": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "POOL",
        "TRIAGED",
        "READY",
        "IN_PROGRESS",
        "VERIFYING",
        "DONE",
        "BLOCKED",
        "FAILED"
      ]
    },
    "exact_next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
