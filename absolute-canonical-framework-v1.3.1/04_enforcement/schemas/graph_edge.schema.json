{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:graph-edge:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "edge_id",
    "source",
    "target",
    "type",
    "direction",
    "evidence_ids",
    "confidence",
    "lifecycle",
    "last_verified_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "edge_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "target": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "DIRECTED",
        "BIDIRECTIONAL"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "lifecycle": {
      "enum": [
        "ACTIVE",
        "STALE",
        "SUPERSEDED",
        "QUARANTINED"
      ]
    },
    "last_verified_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
