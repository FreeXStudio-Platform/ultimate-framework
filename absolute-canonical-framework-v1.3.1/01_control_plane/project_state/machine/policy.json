{
  "schema_version": "1.0.0",
  "module_id": "ABS.MODULE.CONTROL.STATE",
  "policy_version": "1.0.0",
  "scope_id": "ABS.SCOPE.ABS_MODULE_CONTROL_STATE.OPERATING_CONTRACT",
  "truth_scope": [
    "ABS.CONCEPT.PROJECT_STATE"
  ],
  "default_action": "DENY_UNLESS_SCOPE_AUTHORITY_PERMISSION_AND_EVIDENCE_ARE_VALID",
  "rules": [
    {
      "rule_id": "ABS.MODULE.CONTROL.STATE.RULE.001",
      "requirement_id": "ABS.REQ.PROJECT_STATE.001",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.CONTROL.STATE.RULE.002",
      "requirement_id": "ABS.REQ.PROJECT_STATE.002",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.CONTROL.STATE.RULE.003",
      "requirement_id": "ABS.REQ.PROJECT_STATE.003",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    }
  ],
  "states": [
    "ACTIVE",
    "UPDATING",
    "CONFLICTED",
    "RECOVERING",
    "STALE"
  ],
  "transitions": [
    {
      "from": "ACTIVE",
      "to": "UPDATING",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "UPDATING",
      "to": "CONFLICTED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "CONFLICTED",
      "to": "RECOVERING",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "RECOVERING",
      "to": "STALE",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    }
  ],
  "fail_closed_on": [
    "stale or partial write overwrites current state",
    "missing authority",
    "stale evidence",
    "semantic contradiction"
  ],
  "recovery": [
    "stop affected action",
    "restore checkpoint or safe state",
    "repair canonical source/policy",
    "rerun transitive checks"
  ],
  "approval_boundary": [
    "external_write",
    "destructive_action",
    "credential_access",
    "publication",
    "financial_commitment",
    "permission_expansion"
  ],
  "invalidation_triggers": [
    "requirement_change",
    "schema_change",
    "policy_change",
    "interface_change",
    "security_change",
    "candidate_hash_change"
  ]
}
