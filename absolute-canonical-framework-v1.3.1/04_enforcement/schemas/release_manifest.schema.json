{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:release-manifest:1.3.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_id",
    "release_id",
    "candidate_id",
    "version",
    "status",
    "candidate_hash",
    "candidate_tree_hash_algorithm",
    "candidate_tree_exclusions",
    "inventory_scope",
    "inventory_exclusions",
    "files",
    "file_count",
    "total_bytes",
    "integrity_metadata_files",
    "built_from_allowlist",
    "evidence_archive_included",
    "integrity_model",
    "baseline_provenance",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.1"
    },
    "framework_id": {
      "const": "ABS.FRAMEWORK.CANONICAL"
    },
    "release_id": {
      "const": "ABS.RELEASE.1.0.0-RC2"
    },
    "candidate_id": {
      "const": "ABS.CANDIDATE.1.0.0-RC2"
    },
    "version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "RELEASE_CANDIDATE_INDEPENDENT_CERTIFICATION_PENDING"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_tree_hash_algorithm": {
      "const": "sha256-canonical-path-size-content-v1"
    },
    "candidate_tree_exclusions": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 1
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "integrity_metadata_files": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "built_from_allowlist": {
      "const": true
    },
    "evidence_archive_included": {
      "const": false
    },
    "integrity_model": {
      "type": "string",
      "minLength": 1
    },
    "baseline_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "role",
        "clean_zip_sha256",
        "build_evidence_zip_sha256"
      ],
      "properties": {
        "release_id": {
          "const": "ABS.RELEASE.1.0.0-RC1"
        },
        "role": {
          "const": "IMMUTABLE_INPUT_BASELINE"
        },
        "clean_zip_sha256": {
          "pattern": "^[0-9a-f]{64}$"
        },
        "build_evidence_zip_sha256": {
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "inventory_scope": {
      "enum": [
        "CANDIDATE_PAYLOAD",
        "RELEASE_TREE_NON_SELF_REFERENTIAL"
      ]
    },
    "inventory_exclusions": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
