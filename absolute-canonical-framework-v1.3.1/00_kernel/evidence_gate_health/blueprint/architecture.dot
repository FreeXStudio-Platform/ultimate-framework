digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.2"];
node [shape=box,style="rounded",fontname="Arial",fontsize=10];
edge [fontname="Arial",fontsize=9];
input [label="Governed inputs"]; gate [label="Authority + policy",shape=diamond]; op [label="Evidence, gates, health, and completion claims"]; evidence [label="Evidence + checks",shape=diamond]; output [label="Validated output"];
input -> gate [label="scope + identity"]; gate -> op [label="authorized"]; op -> evidence [label="claims"]; evidence -> output [label="pass / truthful state"]; evidence -> op [label="finding",style=dashed];
c0 [label="Consumes\nSCHEMA.VALIDATE",shape=note];
c0 -> input [style=dotted];
c1 [label="Consumes\nTEST.EVALUATE",shape=note];
c1 -> input [style=dotted];
p0 [label="Provides\nEVIDENCE.RECORD",shape=note];
output -> p0 [style=dotted];
p1 [label="Provides\nGATE.EVALUATE",shape=note];
output -> p1 [style=dotted];
label="ABS.MODULE.KERNEL.EVIDENCE_GATES: What exact evidence supports this status and candidate hash?";
}
