{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:profile:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "name",
    "version",
    "purpose",
    "status",
    "required_modules",
    "optional_modules",
    "required_adapters",
    "policy_overlays",
    "installation_mode",
    "authority",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": "1.0.0"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "CANDIDATE",
        "ACTIVE",
        "DEPRECATED"
      ]
    },
    "required_modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      },
      "uniqueItems": true
    },
    "optional_modules": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      },
      "uniqueItems": true
    },
    "required_adapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ABS\\.[A-Z0-9_.-]+$"
      },
      "uniqueItems": true
    },
    "policy_overlays": {
      "type": "object"
    },
    "installation_mode": {
      "enum": [
        "SHADOW_FIRST",
        "DIRECT_TEMPLATE_ONLY"
      ]
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    }
  }
}
