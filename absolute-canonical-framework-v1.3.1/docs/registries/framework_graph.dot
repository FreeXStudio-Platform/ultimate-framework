"ABS.MODULE.ENFORCEMENT.OBSERVABILITY" [label="Observability, error taxonomy, incidents, and fault-seeking health"];
"ABS.MODULE.ARCHITECTURE.MODULARITY" [label="Modular architecture, dependencies, interfaces, and repository governance"];
