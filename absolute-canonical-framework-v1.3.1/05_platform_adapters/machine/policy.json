{
  "schema_version": "1.0.0",
  "module_id": "ABS.MODULE.ADAPTERS.PLATFORMS",
  "policy_version": "1.0.0",
  "scope_id": "ABS.SCOPE.ABS_MODULE_ADAPTERS_PLATFORMS.OPERATING_CONTRACT",
  "truth_scope": [
    "ABS.CONCEPT.PLATFORM_ADAPTERS"
  ],
  "default_action": "DENY_UNLESS_SCOPE_AUTHORITY_PERMISSION_AND_EVIDENCE_ARE_VALID",
  "rules": [
    {
      "rule_id": "ABS.MODULE.ADAPTERS.PLATFORMS.RULE.001",
      "requirement_id": "ABS.REQ.PLATFORM_ADAPTERS.001",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.ADAPTERS.PLATFORMS.RULE.002",
      "requirement_id": "ABS.REQ.PLATFORM_ADAPTERS.002",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.ADAPTERS.PLATFORMS.RULE.003",
      "requirement_id": "ABS.REQ.PLATFORM_ADAPTERS.003",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    }
  ],
  "states": [
    "UNTESTED",
    "PREFLIGHTED",
    "CONFIGURED",
    "CONFORMANT",
    "DEGRADED",
    "INCOMPATIBLE"
  ],
  "transitions": [
    {
      "from": "UNTESTED",
      "to": "PREFLIGHTED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "PREFLIGHTED",
      "to": "CONFIGURED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "CONFIGURED",
      "to": "CONFORMANT",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "CONFORMANT",
      "to": "DEGRADED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "DEGRADED",
      "to": "INCOMPATIBLE",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    }
  ],
  "fail_closed_on": [
    "adapter claims untested host capability",
    "missing authority",
    "stale evidence",
    "semantic contradiction"
  ],
  "recovery": [
    "stop affected action",
    "restore checkpoint or safe state",
    "repair canonical source/policy",
    "rerun transitive checks"
  ],
  "approval_boundary": [
    "external_write",
    "destructive_action",
    "credential_access",
    "publication",
    "financial_commitment",
    "permission_expansion"
  ],
  "invalidation_triggers": [
    "requirement_change",
    "schema_change",
    "policy_change",
    "interface_change",
    "security_change",
    "candidate_hash_change"
  ]
}
