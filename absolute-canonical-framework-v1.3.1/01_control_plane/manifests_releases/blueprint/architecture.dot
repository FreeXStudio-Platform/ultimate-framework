digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.2"];
node [shape=box,style="rounded",fontname="Arial",fontsize=10];
edge [fontname="Arial",fontsize=9];
input [label="Governed inputs"]; gate [label="Authority + policy",shape=diamond]; op [label="Manifests, clean releases, checksums, and migration"]; evidence [label="Evidence + checks",shape=diamond]; output [label="Validated output"];
input -> gate [label="scope + identity"]; gate -> op [label="authorized"]; op -> evidence [label="claims"]; evidence -> output [label="pass / truthful state"]; evidence -> op [label="finding",style=dashed];
c0 [label="Consumes\nEVIDENCE.RECORD",shape=note];
c0 -> input [style=dotted];
c1 [label="Consumes\nGATE.EVALUATE",shape=note];
c1 -> input [style=dotted];
c2 [label="Consumes\nRECOVERY.CHECKPOINT",shape=note];
c2 -> input [style=dotted];
c3 [label="Consumes\nVERIFICATION.INDEPENDENT",shape=note];
c3 -> input [style=dotted];
p0 [label="Provides\nRELEASE.ASSEMBLE",shape=note];
output -> p0 [style=dotted];
label="ABS.MODULE.CONTROL.RELEASE: Can this package be reproduced, extracted safely, and proven clean?";
}
