digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.2"];
node [shape=box,style="rounded",fontname="Arial",fontsize=10];
edge [fontname="Arial",fontsize=9];
input [label="Governed inputs"]; gate [label="Authority + policy",shape=diamond]; op [label="Provider-independent model and execution routing"]; evidence [label="Evidence + checks",shape=diamond]; output [label="Validated output"];
input -> gate [label="scope + identity"]; gate -> op [label="authorized"]; op -> evidence [label="claims"]; evidence -> output [label="pass / truthful state"]; evidence -> op [label="finding",style=dashed];
c0 [label="Consumes\nCAPABILITY.SELECT",shape=note];
c0 -> input [style=dotted];
p0 [label="Provides\nMODEL.ROUTE",shape=note];
output -> p0 [style=dotted];
label="ABS.MODULE.CAPABILITY.ROUTING: Which execution profile satisfies assurance and data boundaries?";
}
