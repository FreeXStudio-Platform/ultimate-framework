{
  "schema_version": "1.0.0",
  "module_id": "ABS.MODULE.KNOWLEDGE.PUBLICATION",
  "policy_version": "1.0.0",
  "scope_id": "ABS.SCOPE.ABS_MODULE_KNOWLEDGE_PUBLICATION.OPERATING_CONTRACT",
  "truth_scope": [
    "ABS.CONCEPT.PUBLICATION_CONFIDENTIALITY"
  ],
  "default_action": "DENY_UNLESS_SCOPE_AUTHORITY_PERMISSION_AND_EVIDENCE_ARE_VALID",
  "rules": [
    {
      "rule_id": "ABS.MODULE.KNOWLEDGE.PUBLICATION.RULE.001",
      "requirement_id": "ABS.REQ.PUBLICATION_CONFIDENTIALITY.001",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.KNOWLEDGE.PUBLICATION.RULE.002",
      "requirement_id": "ABS.REQ.PUBLICATION_CONFIDENTIALITY.002",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.KNOWLEDGE.PUBLICATION.RULE.003",
      "requirement_id": "ABS.REQ.PUBLICATION_CONFIDENTIALITY.003",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    }
  ],
  "states": [
    "DRAFT",
    "SANITIZING",
    "REVIEW_REQUIRED",
    "APPROVED",
    "PUBLISHED",
    "STALE",
    "REVOKED"
  ],
  "transitions": [
    {
      "from": "DRAFT",
      "to": "SANITIZING",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "SANITIZING",
      "to": "REVIEW_REQUIRED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "REVIEW_REQUIRED",
      "to": "APPROVED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "APPROVED",
      "to": "PUBLISHED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "PUBLISHED",
      "to": "STALE",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "STALE",
      "to": "REVOKED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    }
  ],
  "fail_closed_on": [
    "restricted or unsupported claim enters a derivative",
    "missing authority",
    "stale evidence",
    "semantic contradiction"
  ],
  "recovery": [
    "stop affected action",
    "restore checkpoint or safe state",
    "repair canonical source/policy",
    "rerun transitive checks"
  ],
  "approval_boundary": [
    "external_write",
    "destructive_action",
    "credential_access",
    "publication",
    "financial_commitment",
    "permission_expansion"
  ],
  "invalidation_triggers": [
    "requirement_change",
    "schema_change",
    "policy_change",
    "interface_change",
    "security_change",
    "candidate_hash_change"
  ]
}
