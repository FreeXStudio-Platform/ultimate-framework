{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:capability-record:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "name",
    "class",
    "provider",
    "version",
    "purpose",
    "non_purpose",
    "permissions",
    "approval_mode",
    "data_scope",
    "trust_state",
    "activation_state",
    "health",
    "fallbacks",
    "rollback"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "class": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "non_purpose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "external",
        "destructive"
      ],
      "properties": {
        "read": {
          "type": "boolean"
        },
        "write": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        }
      }
    },
    "approval_mode": {
      "type": "string",
      "minLength": 1
    },
    "data_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "trust_state": {
      "type": "string",
      "minLength": 1
    },
    "activation_state": {
      "enum": [
        "DISABLED",
        "ENABLED",
        "DEGRADED",
        "UNAVAILABLE",
        "QUARANTINED",
        "REMOVED"
      ]
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "checked_at"
      ],
      "properties": {
        "state": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "UNAVAILABLE",
            "UNKNOWN",
            "STALE"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "fallbacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    }
  }
}
