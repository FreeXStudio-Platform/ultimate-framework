{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:release-allowlist:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_id",
    "release_id",
    "candidate_id",
    "policy",
    "generator",
    "classification_policy_version",
    "baseline_provenance",
    "baseline_verification",
    "record_count",
    "derivative_status_counts",
    "records"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "framework_id": {"const": "ABS.FRAMEWORK.CANONICAL"},
    "release_id": {"const": "ABS.RELEASE.1.3.1"},
    "candidate_id": {"const": "ABS.CANDIDATE.1.3.1"},
    "policy": {"const": "EXACT_RECORD_SET_FAIL_CLOSED"},
    "generator": {
      "const": "01_control_plane/manifests_releases/tools/generate_release_allowlist.py"
    },
    "classification_policy_version": {"const": "1.0.0"},
    "baseline_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "role",
        "clean_zip_sha256",
        "build_evidence_zip_sha256"
      ],
      "properties": {
        "release_id": {"const": "ABS.RELEASE.1.0.0-RC2"},
        "role": {"const": "IMMUTABLE_INPUT_BASELINE"},
        "clean_zip_sha256": {
          "const": "3e403e5ea37c9f530cb69afbced5a841018a5e842d4610c3ab3dda21776fd7ba"
        },
        "build_evidence_zip_sha256": {
          "const": "2c84aeeb3b7e29bdf39e0bee7924b033b395f8222e3cffd7623a425d400a4a1d"
        }
      }
    },
    "baseline_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_root",
        "release_id",
        "checksum_ledger_verified",
        "verified_member_count"
      ],
      "properties": {
        "package_root": {"const": "absolute-canonical-framework-v1.0.0-rc.2"},
        "release_id": {"const": "ABS.RELEASE.1.0.0-RC2"},
        "checksum_ledger_verified": {"const": true},
        "verified_member_count": {"type": "integer", "minimum": 1}
      }
    },
    "record_count": {"type": "integer", "minimum": 1},
    "derivative_status_counts": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "PRESERVED_EXACT_FROM_BASELINE": {"type": "integer", "minimum": 1},
        "MODIFIED_SINCE_BASELINE": {"type": "integer", "minimum": 1},
        "NEW_SINCE_BASELINE": {"type": "integer", "minimum": 1},
        "GENERATED_BUILD_CONTROL": {"type": "integer", "minimum": 1}
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "artifact_class",
          "source_identity",
          "derivative_status"
        ],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "artifact_class": {
            "enum": [
              "RELEASE_INTEGRITY_METADATA",
              "GOVERNANCE_RECORD",
              "MACHINE_SCHEMA",
              "EXECUTABLE_TOOL",
              "TEST_ASSET",
              "MODULE_MANIFEST",
              "NORMATIVE_DOCUMENTATION",
              "BLUEPRINT_SOURCE",
              "VISUAL_DERIVATIVE",
              "CONFIGURATION",
              "REGISTRY",
              "EXAMPLE",
              "LICENSE",
              "OTHER_CANONICAL_PAYLOAD"
            ]
          },
          "source_identity": {"type": "string", "minLength": 1},
          "derivative_status": {
            "enum": [
              "PRESERVED_EXACT_FROM_BASELINE",
              "MODIFIED_SINCE_BASELINE",
              "NEW_SINCE_BASELINE",
              "GENERATED_BUILD_CONTROL"
            ]
          }
        }
      }
    }
  }
}
