  "scope_id": "ABS.SCOPE.ABS_MODULE_KNOWLEDGE_CANONICAL_MODULE.OPERATING_CONTRACT",
  "truth_scope": [
    "ABS.CONCEPT.CANONICAL_MODULE_PACKAGE"
  ],
  "default_action": "DENY_UNLESS_SCOPE_AUTHORITY_PERMISSION_AND_EVIDENCE_ARE_VALID",
  "rules": [
    {
      "rule_id": "ABS.MODULE.KNOWLEDGE.CANONICAL_MODULE.RULE.001",
      "requirement_id": "ABS.REQ.CANONICAL_MODULE_PACKAGE.001",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.KNOWLEDGE.CANONICAL_MODULE.RULE.002",
      "requirement_id": "ABS.REQ.CANONICAL_MODULE_PACKAGE.002",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.KNOWLEDGE.CANONICAL_MODULE.RULE.003",
      "requirement_id": "ABS.REQ.CANONICAL_MODULE_PACKAGE.003",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    }
  ],
  "states": [
    "DRAFT",
    "CANDIDATE",
    "VERIFIED",
    "CERTIFIED",
    "SUPERSEDED"
  ],
  "transitions": [
    {
      "from": "DRAFT",
      "to": "CANDIDATE",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "CANDIDATE",
      "to": "VERIFIED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "VERIFIED",
      "to": "CERTIFIED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "CERTIFIED",
      "to": "SUPERSEDED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    }
  ],
  "fail_closed_on": [
    "representations become independent truth islands",
    "missing authority",
    "stale evidence",
    "semantic contradiction"
  ],
  "recovery": [
    "stop affected action",
    "restore checkpoint or safe state",
    "repair canonical source/policy",
    "rerun transitive checks"
  ],
  "approval_boundary": [
    "external_write",
    "destructive_action",
    "credential_access",
    "publication",
    "financial_commitment",
    "permission_expansion"
  ],
  "invalidation_triggers": [
    "requirement_change",
    "schema_change",
    "policy_change",
    "interface_change",
    "security_change",
    "candidate_hash_change"
  ]
}
