{
  "schema_version": "1.0.0",
  "module_id": "ABS.MODULE.CONTROL.RELEASE",
  "policy_version": "1.0.0",
  "scope_id": "ABS.SCOPE.ABS_MODULE_CONTROL_RELEASE.OPERATING_CONTRACT",
  "truth_scope": [
    "ABS.CONCEPT.MANIFEST_RELEASE"
  ],
  "default_action": "DENY_UNLESS_SCOPE_AUTHORITY_PERMISSION_AND_EVIDENCE_ARE_VALID",
  "rules": [
    {
      "rule_id": "ABS.MODULE.CONTROL.RELEASE.RULE.001",
      "requirement_id": "ABS.REQ.MANIFEST_RELEASE.001",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.CONTROL.RELEASE.RULE.002",
      "requirement_id": "ABS.REQ.MANIFEST_RELEASE.002",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.CONTROL.RELEASE.RULE.003",
      "requirement_id": "ABS.REQ.MANIFEST_RELEASE.003",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    }
  ],
  "states": [
    "CANDIDATE_FROZEN",
    "STAGED",
    "VALIDATED",
    "PACKAGED",
    "EXTRACTED_VERIFIED",
    "RELEASED",
    "REJECTED"
  ],
  "transitions": [
    {
      "from": "CANDIDATE_FROZEN",
      "to": "STAGED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "STAGED",
      "to": "VALIDATED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "VALIDATED",
      "to": "PACKAGED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "PACKAGED",
      "to": "EXTRACTED_VERIFIED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "EXTRACTED_VERIFIED",
      "to": "RELEASED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "RELEASED",
      "to": "REJECTED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    }
  ],
  "fail_closed_on": [
    "unexpected or unmanifested file enters release",
    "missing authority",
    "stale evidence",
    "semantic contradiction"
  ],
  "recovery": [
    "stop affected action",
    "restore checkpoint or safe state",
    "repair canonical source/policy",
    "rerun transitive checks"
  ],
  "approval_boundary": [
    "external_write",
    "destructive_action",
    "credential_access",
    "publication",
    "financial_commitment",
    "permission_expansion"
  ],
  "invalidation_triggers": [
    "requirement_change",
    "schema_change",
    "policy_change",
    "interface_change",
    "security_change",
    "candidate_hash_change"
  ]
}
