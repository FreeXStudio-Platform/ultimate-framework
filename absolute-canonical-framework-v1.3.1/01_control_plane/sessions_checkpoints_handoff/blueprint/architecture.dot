digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.2"];
node [shape=box,style="rounded",fontname="Arial",fontsize=10];
edge [fontname="Arial",fontsize=9];
input [label="Governed inputs"]; gate [label="Authority + policy",shape=diamond]; op [label="Sessions, checkpoints, context, and handoff"]; evidence [label="Evidence + checks",shape=diamond]; output [label="Validated output"];
input -> gate [label="scope + identity"]; gate -> op [label="authorized"]; op -> evidence [label="claims"]; evidence -> output [label="pass / truthful state"]; evidence -> op [label="finding",style=dashed];
c0 [label="Consumes\nLIFECYCLE.TRANSITION",shape=note];
c0 -> input [style=dotted];
c1 [label="Consumes\nRECOVERY.CHECKPOINT",shape=note];
c1 -> input [style=dotted];
c2 [label="Consumes\nWORK.PACKET",shape=note];
c2 -> input [style=dotted];
p0 [label="Provides\nSESSION.HANDOFF",shape=note];
output -> p0 [style=dotted];
label="ABS.MODULE.CONTROL.SESSIONS: Can another agent resume without reading the transcript?";
}
