digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.2"];
node [shape=box,style="rounded",fontname="Arial",fontsize=10];
edge [fontname="Arial",fontsize=9];
input [label="Governed inputs"]; gate [label="Authority + policy",shape=diamond]; op [label="Decision, risk, assumption, unknown, and waiver control"]; evidence [label="Evidence + checks",shape=diamond]; output [label="Validated output"];
input -> gate [label="scope + identity"]; gate -> op [label="authorized"]; op -> evidence [label="claims"]; evidence -> output [label="pass / truthful state"]; evidence -> op [label="finding",style=dashed];
c0 [label="Consumes\nSTATE.ATOMIC_UPDATE",shape=note];
c0 -> input [style=dotted];
p0 [label="Provides\nDECISION.RECORD",shape=note];
output -> p0 [style=dotted];
label="ABS.MODULE.CONTROL.DECISIONS: Who may decide this issue, and what reopens it?";
}
