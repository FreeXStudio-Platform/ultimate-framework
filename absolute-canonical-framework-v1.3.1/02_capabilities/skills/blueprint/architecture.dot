digraph module {
graph [rankdir=LR,bgcolor="transparent",pad="0.2"];
node [shape=box,style="rounded",fontname="Arial",fontsize=10];
edge [fontname="Arial",fontsize=9];
input [label="Governed inputs"]; gate [label="Authority + policy",shape=diamond]; op [label="Skills, subagents, and delegation contracts"]; evidence [label="Evidence + checks",shape=diamond]; output [label="Validated output"];
input -> gate [label="scope + identity"]; gate -> op [label="authorized"]; op -> evidence [label="claims"]; evidence -> output [label="pass / truthful state"]; evidence -> op [label="finding",style=dashed];
p0 [label="Provides\nSKILL.EXECUTE",shape=note];
output -> p0 [style=dotted];
label="ABS.MODULE.CAPABILITY.SKILLS: Is this task bounded enough for a skill, and what stops it?";
}
