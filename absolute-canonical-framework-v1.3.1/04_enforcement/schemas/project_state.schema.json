{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:project-state:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_id",
    "project_id",
    "active_goal_id",
    "phase",
    "active_work_packet",
    "candidate_hash",
    "status",
    "rollback_ref",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "framework_id": {
      "const": "ABS.FRAMEWORK.CANONICAL"
    },
    "project_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "active_goal_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "active_work_packet": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "UPDATING",
        "CONFLICTED",
        "RECOVERING",
        "STALE"
      ]
    },
    "rollback_ref": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
