{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://absolute.local/v2/finding.schema.json",
  "title": "Absolute Coverage Closure V2 Finding",
  "type": "object",
  "required": [
    "finding_id",
    "title",
    "severity",
    "state",
    "expected_behavior",
    "actual_behavior",
    "evidence_ids"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^ABS-CC-F-"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "state": {
      "enum": [
        "OPEN",
        "CONFIRMED",
        "DISPROVED",
        "DUPLICATE",
        "BLOCKED",
        "REMEDIATION_PLANNED",
        "REMEDIATED_PENDING_REVALIDATION",
        "RESOLVED",
        "ACCEPTED_NONBLOCKING_RISK",
        "DEFERRED_WITH_TRIGGER"
      ]
    },
    "scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "candidate_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirement_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "knowledge_unit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "surface_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gate_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "config_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected_behavior": {
      "type": "string"
    },
    "actual_behavior": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "root_cause": {
      "type": [
        "string",
        "null"
      ]
    },
    "blast_radius": {
      "type": [
        "string",
        "null"
      ]
    },
    "transitive_dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remediation": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closure_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
