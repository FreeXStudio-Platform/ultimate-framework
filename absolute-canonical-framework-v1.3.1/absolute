#!/usr/bin/env python3
"""Absolute Canonical Framework runtime entry point.

Kept at the release root so a project can invoke the framework it installed from
without installing a Python package:

    python3 /path/to/absolute-canonical-framework-v1.0.0/absolute status
"""
from __future__ import annotations

import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))

from runtime.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
