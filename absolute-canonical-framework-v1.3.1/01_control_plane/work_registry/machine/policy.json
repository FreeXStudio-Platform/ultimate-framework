{
  "schema_version": "1.0.0",
  "module_id": "ABS.MODULE.CONTROL.WORK",
  "policy_version": "1.0.0",
  "scope_id": "ABS.SCOPE.ABS_MODULE_CONTROL_WORK.OPERATING_CONTRACT",
  "truth_scope": [
    "ABS.CONCEPT.WORK_REGISTRY"
  ],
  "default_action": "DENY_UNLESS_SCOPE_AUTHORITY_PERMISSION_AND_EVIDENCE_ARE_VALID",
  "rules": [
    {
      "rule_id": "ABS.MODULE.CONTROL.WORK.RULE.001",
      "requirement_id": "ABS.REQ.WORK_REGISTRY.001",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.CONTROL.WORK.RULE.002",
      "requirement_id": "ABS.REQ.WORK_REGISTRY.002",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    },
    {
      "rule_id": "ABS.MODULE.CONTROL.WORK.RULE.003",
      "requirement_id": "ABS.REQ.WORK_REGISTRY.003",
      "condition": "governed action or claim is in module scope",
      "effect": "REQUIRE_CONFORMANCE_AND_EVIDENCE",
      "on_failure": "BLOCK_AND_RECORD_FINDING"
    }
  ],
  "states": [
    "POOL",
    "TRIAGED",
    "READY",
    "IN_PROGRESS",
    "VERIFYING",
    "DONE",
    "BLOCKED",
    "FAILED"
  ],
  "transitions": [
    {
      "from": "POOL",
      "to": "TRIAGED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "TRIAGED",
      "to": "READY",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "READY",
      "to": "IN_PROGRESS",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "IN_PROGRESS",
      "to": "VERIFYING",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "VERIFYING",
      "to": "DONE",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "DONE",
      "to": "BLOCKED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    },
    {
      "from": "BLOCKED",
      "to": "FAILED",
      "requires": [
        "valid_scope",
        "authority",
        "permission",
        "evidence_or_explicit_not_run"
      ]
    }
  ],
  "fail_closed_on": [
    "work is marked done before acceptance",
    "missing authority",
    "stale evidence",
    "semantic contradiction"
  ],
  "recovery": [
    "stop affected action",
    "restore checkpoint or safe state",
    "repair canonical source/policy",
    "rerun transitive checks"
  ],
  "approval_boundary": [
    "external_write",
    "destructive_action",
    "credential_access",
    "publication",
    "financial_commitment",
    "permission_expansion"
  ],
  "invalidation_triggers": [
    "requirement_change",
    "schema_change",
    "policy_change",
    "interface_change",
    "security_change",
    "candidate_hash_change"
  ]
}
