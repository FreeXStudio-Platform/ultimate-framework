digraph framework {
graph [rankdir=LR,bgcolor="transparent"];
node [shape=box,style=rounded,fontname=Arial,fontsize=9];
"ABS.MODULE.KERNEL.GOAL_LOCK" [label="Goal lock and mission alignment"];
"ABS.MODULE.KERNEL.IDENTITY" [label="Project identity and isolation"];
"ABS.MODULE.KERNEL.AUTHORITY_TRUTH" [label="Scoped authority, truth states, and conflict handling"];
"ABS.MODULE.KERNEL.LIFECYCLE" [label="Lifecycle and two-pass completion"];
