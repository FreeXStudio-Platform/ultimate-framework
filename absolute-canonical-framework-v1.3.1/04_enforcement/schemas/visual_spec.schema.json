{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:absolute:schema:visual-spec:1.0.0",
  "title": "Absolute Visual Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "visual_id",
    "module_id",
    "scope_id",
    "reader_question",
    "communication_intent",
    "audience",
    "truth_context",
    "data_source",
    "visual_grammar",
    "semantic_encodings",
    "renderer",
    "accessibility",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "visual_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "scope_id": {
      "type": "string",
      "pattern": "^ABS\\.[A-Z0-9_.-]+$"
    },
    "reader_question": {
      "type": "string",
      "minLength": 1
    },
    "communication_intent": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "truth_context": {
      "type": "string",
      "minLength": 1
    },
    "data_source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visual_grammar": {
      "type": "string",
      "minLength": 1
    },
    "semantic_encodings": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "route",
        "source",
        "output",
        "runtime_version"
      ],
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "runtime_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alt_text",
        "static_fallback"
      ],
      "properties": {
        "alt_text": {
          "type": "string",
          "minLength": 1
        },
        "static_fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
